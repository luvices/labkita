#!/usr/bin/env python3
"""Suite pengujian mandiri LabKita Linux (Offline Self-Diagnostic Suite)."""
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile


def verify_guide_open(report, base):
    """Siapkan panduan via labkita-guide --prepare dan verifikasi keterbacaan dalam sandbox browser."""
    guide_src = base / "guide/index.html"
    report("Berkas panduan lokal", guide_src.is_file() and guide_src.stat().st_size > 0)
    launcher = Path("/usr/local/bin/labkita-guide")
    report("Skrip peluncur panduan", launcher.is_file() and os.access(launcher, os.X_OK))

    run_prefix = []
    run_env = dict(os.environ)
    sudo_user = os.environ.get("SUDO_USER")
    if os.geteuid() == 0 and sudo_user and sudo_user != "root":
        home_dir = Path("/home") / sudo_user
        if home_dir.is_dir():
            run_prefix = ["runuser", "-u", sudo_user, "--"]
            run_env["HOME"] = str(home_dir)

    target_path = None
    try:
        prep = subprocess.run(
            run_prefix + [str(launcher), "--prepare"],
            capture_output=True,
            text=True,
            timeout=10,
            env=run_env,
        )
        candidate = prep.stdout.strip().splitlines()[-1] if prep.stdout.strip() else ""
        if prep.returncode == 0 and candidate:
            target_path = Path(candidate)
        no_dot = target_path is not None and not any(part.startswith(".") for part in target_path.parts)
        readable_html = (
            no_dot
            and target_path.is_file()
            and "Praktikum Pemrograman Mandiri" in target_path.read_text(encoding="utf-8", errors="ignore")
        )
        report("Lokasi panduan non-dotfolder (~/Dokumen)", readable_html, str(target_path or prep.stderr.strip()))
    except (OSError, subprocess.SubprocessError) as error:
        report("Lokasi panduan non-dotfolder (~/Dokumen)", False, str(error))

    html_handler = ""
    if shutil.which("xdg-mime"):
        try:
            html_handler = subprocess.check_output(
                run_prefix + ["xdg-mime", "query", "default", "text/html"],
                text=True,
                stderr=subprocess.DEVNULL,
                env=run_env,
                timeout=10,
            ).strip()
        except (OSError, subprocess.SubprocessError):
            html_handler = ""
    report("Asosiasi penampil HTML (xdg-mime)", bool(html_handler), html_handler or "tidak ada handler")

    if target_path and target_path.is_file() and shutil.which("snap"):
        snap_ff = subprocess.run(["snap", "list", "firefox"], capture_output=True, text=True, timeout=10)
        if snap_ff.returncode == 0:
            if os.geteuid() == 0 and not run_prefix:
                report("Pembacaan panduan oleh sandbox Firefox Snap", False, "Jalankan sebagai user non-root")
                return
            try:
                sandbox = subprocess.run(
                    run_prefix + ["snap", "run", "--shell", "firefox", "-c", 'cat "$1"', "_", str(target_path)],
                    capture_output=True,
                    text=True,
                    timeout=15,
                    env=run_env,
                )
                ok = sandbox.returncode == 0 and "Praktikum Pemrograman Mandiri" in sandbox.stdout
                report("Pembacaan panduan oleh sandbox Firefox Snap", ok, sandbox.stderr.strip() if not ok else "AppArmor OK")
                return
            except (OSError, subprocess.SubprocessError) as error:
                report("Pembacaan panduan oleh sandbox Firefox Snap", False, str(error))
                return

    browser_bin = shutil.which("firefox") or shutil.which("chromium") or shutil.which("xdg-open")
    ok_fallback = bool(browser_bin and target_path and target_path.is_file() and os.access(target_path, os.R_OK))
    report("Keterbacaan panduan oleh penampil sistem", ok_fallback, browser_bin or "tidak ditemukan")


def main():
    failures = []

    def report(label, ok, detail=""):
        status = "LULUS" if ok else "GAGAL"
        msg = f"[{status}] {label}"
        if detail:
            msg += f" ({detail})"
        print(msg)
        if not ok:
            failures.append(label)

    print("=== Pemeriksaan Kesiapan LabKita Linux 0.5.1 ===")

    # 1. Pemeriksaan Toolchain & Aplikasi Dasar
    for command in ("python3", "gcc", "g++", "make", "geany", "git", "man"):
        report(f"Program {command}", shutil.which(command) is not None)

    # 2. Materi Panduan & Dokumentasi Offline (termasuk uji baca dalam sandbox)
    base = Path("/usr/share/labkita")
    verify_guide_open(report, base)
    report("Dokumentasi Python offline", Path("/usr/share/doc/python3/html/index.html").is_file())

    # 3. Konfigurasi Bahasa dan Zona Waktu
    try:
        locales = subprocess.check_output(["locale", "-a"], text=True, stderr=subprocess.DEVNULL)
        has_id = any(loc in locales for loc in ("id_ID", "id_ID.utf8", "id_ID.UTF-8"))
        report("Dukungan Bahasa Indonesia (id_ID.UTF-8)", has_id)
    except Exception as e:
        report("Dukungan Bahasa Indonesia (id_ID.UTF-8)", False, str(e))

    try:
        tz = ""
        if Path("/etc/timezone").is_file():
            tz = Path("/etc/timezone").read_text(encoding="utf-8").strip()
        elif Path("/etc/localtime").is_symlink():
            tz = str(Path("/etc/localtime").resolve())
        report("Zona waktu Asia/Jakarta", "Jakarta" in tz or "WIB" in tz or "GMT+7" in tz or "Asia/Jakarta" in tz)
    except Exception as e:
        report("Zona waktu Asia/Jakarta", False, str(e))

    # 4. Tema Antarmuka & Visual (WhiteSur, Symlink Ikon, Plymouth & Wallpaper Orisinal)
    report("Tema GTK WhiteSur", Path("/usr/share/themes/WhiteSur-Light").is_dir())
    report("Set Ikon WhiteSur", Path("/usr/share/icons/WhiteSur").is_dir())
    sample_icon = Path("/usr/share/icons/WhiteSur/apps/scalable/utilities-terminal.svg")
    sample_link = Path("/usr/share/icons/WhiteSur/status/16/ac-adapter.svg")
    icons_ok = sample_icon.is_file() and (sample_link.is_symlink() or (sample_link.is_file() and sample_link.stat().st_size > 120))
    report("Integritas symlink ikon WhiteSur", icons_ok)
    report("Tema Kursor WhiteSur", Path("/usr/share/icons/WhiteSur-cursors").is_dir())
    report("Wallpaper Orisinal LabKita", Path("/usr/share/backgrounds/labkita-gradient.png").is_file() or Path("/usr/share/backgrounds/labkita.svg").is_file())
    report("Aset Splash Boot LabKita (Plymouth)", Path("/usr/share/plymouth/themes/spinner/watermark.png").is_file() and Path("/usr/share/plymouth/themes/spinner/bgrt-fallback.png").is_file())

    # 5. Pengujian Kompilasi dan Eksekusi Kode Praktikum
    with tempfile.TemporaryDirectory(prefix="labkita-check-") as directory:
        work = Path(directory)
        for label, args, expected in (
            ("Eksekusi contoh Python", [sys.executable, str(base / "examples/hello.py")], "Halo dari LabKita Linux!"),
            ("Eksekusi proses anak (fork/multiprocess)", [sys.executable, str(base / "examples/processes.py")], "Semua proses anak selesai."),
        ):
            try:
                result = subprocess.run(args, capture_output=True, text=True, timeout=15, cwd=work)
                report(label, result.returncode == 0 and expected in result.stdout, result.stderr.strip())
            except (OSError, subprocess.TimeoutExpired) as error:
                report(label, False, str(error))

        if shutil.which("gcc"):
            try:
                binary = work / "hello"
                subprocess.run(
                    ["gcc", "-Wall", "-Wextra", "-Werror", str(base / "examples/hello.c"), "-o", str(binary)],
                    check=True,
                    capture_output=True,
                    text=True,
                    timeout=30,
                )
                result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=10)
                report(
                    "Kompilasi dan eksekusi C",
                    result.returncode == 0 and result.stdout.strip() == "Halo dari LabKita Linux!",
                )
            except (OSError, subprocess.SubprocessError) as error:
                report("Kompilasi dan eksekusi C", False, str(error))

    # 6. Keamanan Ruang Kerja Sementara & Layanan Systemd
    runtime = Path("/run/labkita")
    ready = runtime.is_dir() and stat.S_IMODE(runtime.stat().st_mode) == 0o1777
    report("Ruang kerja sementara tmpfs (/run/labkita) dengan sticky bit 1777", ready)

    try:
        active = subprocess.run(["systemctl", "is-active", "--quiet", "labkita-runtime.service"], timeout=10).returncode == 0
        report("Status aktif layanan labkita-runtime.service", active)
    except (OSError, subprocess.SubprocessError) as error:
        report("Status aktif layanan labkita-runtime.service", False, str(error))

    print("=========================================")
    if failures:
        print(f"Hasil: {len(failures)} pemeriksaan GAGAL. Harap periksa konfigurasi sistem.")
        return 1
    else:
        print("Hasil: SEMUA PEMERIKSAAN LULUS (Sistem siap digunakan untuk praktikum).")
        return 0


if __name__ == "__main__":
    sys.exit(main())
