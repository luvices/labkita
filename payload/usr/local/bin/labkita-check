#!/usr/bin/env python3
"""Uji lokal tanpa mengunduh paket atau menghubungi jaringan."""
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile


def main():
    failures = []

    def report(label, ok, detail=""):
        print(f"{'LULUS' if ok else 'GAGAL'} | {label}" + (f" | {detail}" if detail else ""))
        if not ok:
            failures.append(label)

    for command in ("python3", "gcc", "g++", "make", "geany", "git", "man"):
        report(f"Program {command}", shutil.which(command) is not None)
    base = Path("/usr/share/labkita")
    report("Panduan lokal", (base / "guide/index.html").is_file())
    report("Dokumentasi Python", Path("/usr/share/doc/python3/html/index.html").is_file())

    with tempfile.TemporaryDirectory(prefix="labkita-check-") as directory:
        work = Path(directory)
        for label, args, expected in (
            ("Contoh Python", [sys.executable, str(base / "examples/hello.py")], "Halo dari LabKita Linux!"),
            ("Proses anak", [sys.executable, str(base / "examples/processes.py")], "Semua proses anak selesai."),
        ):
            try:
                result = subprocess.run(args, capture_output=True, text=True, timeout=15, cwd=work)
                report(label, result.returncode == 0 and expected in result.stdout, result.stderr.strip())
            except (OSError, subprocess.TimeoutExpired) as error:
                report(label, False, str(error))
        if shutil.which("gcc"):
            try:
                binary = work / "hello"
                subprocess.run(["gcc", "-Wall", "-Wextra", "-Werror", str(base / "examples/hello.c"), "-o", str(binary)], check=True, capture_output=True, text=True, timeout=30)
                result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=10)
                report("Compile dan jalankan C", result.returncode == 0 and result.stdout.strip() == "Halo dari LabKita Linux!")
            except (OSError, subprocess.SubprocessError) as error:
                report("Compile dan jalankan C", False, str(error))

    runtime = Path("/run/labkita")
    ready = runtime.is_dir() and stat.S_IMODE(runtime.stat().st_mode) == 0o1777
    report("Ruang sementara dengan sticky bit", ready)
    try:
        active = subprocess.run(["systemctl", "is-active", "--quiet", "labkita-runtime.service"], timeout=10).returncode == 0
        report("Layanan systemd", active)
    except (OSError, subprocess.SubprocessError) as error:
        report("Layanan systemd", False, str(error))
    print(f"\n{len(failures)} pemeriksaan gagal. Jalankan di LabKita yang sudah boot.")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
