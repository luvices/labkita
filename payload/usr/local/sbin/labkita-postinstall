#!/usr/bin/env bash
# Jalankan di LabKita yang SUDAH diinstal ke VM, menggunakan akun administrator.
set -Eeuo pipefail
account=${1:-praktikan}
if [[ $EUID -ne 0 || ! -f /etc/labkita-release ]]; then
    printf 'Jalankan di LabKita terinstal: sudo labkita-postinstall [nama-akun]\n' >&2
    exit 1
fi
if [[ ! $account =~ ^[a-z][a-z0-9_-]{0,30}$ ]]; then
    printf 'Nama akun tidak valid. Gunakan huruf kecil, angka, _ atau -.\n' >&2
    exit 2
fi
if id "$account" >/dev/null 2>&1; then
    printf 'Akun %s sudah ada; tidak diubah. Pilih nama baru.\n' "$account" >&2
    exit 2
fi
if [[ -e /home/$account || -L /home/$account ]]; then
    printf 'Folder /home/%s sudah ada; tidak diubah. Pilih nama baru.\n' "$account" >&2
    exit 2
fi
getent group labkita >/dev/null || groupadd --system labkita
useradd --create-home --user-group --shell /bin/bash --groups labkita "$account"
chmod 0700 "/home/$account"
printf 'Tetapkan password pribadi untuk %s. Password tidak disimpan dalam skrip.\n' "$account"
if ! passwd "$account"; then
    printf 'Password belum terpasang. Akun tetap terkunci; ulangi: sudo passwd %s\n' "$account" >&2
    exit 1
fi
printf 'Akun %s dibuat tanpa grup sudo. Folder pribadi: /home/%s\n' "$account" "$account"
printf 'Pengguna masih dapat menjalankan program; ini bukan mode kiosk.\n'
